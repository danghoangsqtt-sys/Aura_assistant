{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "types": [
      "node"
    ],
    "lib": [
      "ES2020",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "baseUrl": ".",
    "paths": {
      "@shared/*":  ["src/shared/*"],
      "@desktop/*": ["src/desktop/*"],
      "@webapp/*":  ["src/webapp/*"]
    }
  },
  "include": [
    "."
  ],
  "exclude": [
    "vite.config.ts",
    "node_modules",
    "test2.ts",
    "test_genai.ts",
    "test_genai.mjs",
    "backup_v1",
    "_backup_root",
    "release"
  ],
  "references": [
    {
      "path": "./tsconfig.node.json"
    }
  ]
}