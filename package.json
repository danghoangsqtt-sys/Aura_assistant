{
    "name":  "aura-ai-assistant",
    "private":  true,
    "version":  "1.2.0",
    "type":  "module",
    "main":  "electron/main.js",
    "scripts":  {
                    "dev":  "vite",
                    "build:proxy":  "node scripts/build-proxy.cjs",
                    "typecheck":  "tsc --noEmit",
                    "build":  "tsc \u0026\u0026 vite build",
                    "preview":  "vite preview",
                    "check":  "npm run typecheck \u0026\u0026 npm run build",
                    "kill-dev-port":  "node scripts/kill-port.cjs 5173",
                    "electron:dev":  "npm run kill-dev-port \u0026\u0026 cross-env NODE_ENV=development concurrently \"vite --port 5173 --strictPort\" \"wait-on tcp:5173 \u0026\u0026 electron .\"",
                    "electron:build":  "npm run build:proxy \u0026\u0026 npm run build \u0026\u0026 electron-builder",
                    "electron:dist":  "npm run build \u0026\u0026 electron-builder --win"
                },
    "build":  {
                  "appId":  "com.dh-system.aura-assistant",
                  "productName":  "Aura Assistant",
                  "copyright":  "Copyright © 2025-2026 DH System - Đăng Hoàng",
                  "directories":  {
                                      "output":  "release"
                                  },
                  "files":  [
                                "dist/**/*",
                                "electron/**/*",
                                "resources/**/*",
                                "public/**/*"
                            ],
                  "win":  {
                              "target":  [
                                             {
                                                 "target":  "nsis",
                                                 "arch":  [
                                                              "x64"
                                                          ]
                                             },
                                             {
                                                 "target":  "portable",
                                                 "arch":  [
                                                              "x64"
                                                          ]
                                             }
                                         ],
                              "icon":  "public/aura_npc_logo.png",
                              "legalTrademarks":  "DH System © 2025-2026",
                              "requestedExecutionLevel":  "asInvoker"
                          },
                  "nsis":  {
                               "oneClick":  false,
                               "allowToChangeInstallationDirectory":  true,
                               "allowElevation":  true,
                               "createDesktopShortcut":  true,
                               "createStartMenuShortcut":  true,
                               "shortcutName":  "Aura Assistant",
                               "deleteAppDataOnUninstall":  false,
                               "license":  "LICENSE.txt"
                           }
              },
    "dependencies":  {
                         "@google/genai":  "^1.31.0",
                         "@mediapipe/tasks-vision":  "^0.10.32",
                         "active-win":  "^7.7.2",
                         "adm-zip":  "^0.5.17",
                         "appwrite":  "^24.1.1",
                         "framer-motion":  "^12.0.0",
                         "lucide-react":  "^0.475.0",
                         "mammoth":  "^1.12.0",
                         "node-cron":  "^4.2.1",
                         "pdf-parse":  "^2.4.5",
                         "pixi-live2d-display":  "^0.3.1",
                         "pixi.js":  "^6.5.10",
                         "react":  "^19.0.0",
                         "react-dom":  "^19.0.0",
                         "react-markdown":  "^10.1.0",
                         "remark-gfm":  "^4.0.1"
                     },
    "devDependencies":  {
                            "@types/node":  "^25.0.1",
                            "@types/react":  "^19.0.0",
                            "@types/react-dom":  "^19.0.0",
                            "@types/three":  "^0.183.1",
                            "@vitejs/plugin-react":  "^4.2.1",
                            "autoprefixer":  "^10.4.20",
                            "concurrently":  "^9.2.1",
                            "cross-env":  "^10.1.0",
                            "electron":  "^41.2.0",
                            "electron-builder":  "^26.8.1",
                            "postcss":  "^8.4.49",
                            "tailwindcss":  "^3.4.17",
                            "typescript":  "^5.2.2",
                            "vite":  "^7.0.0",
                            "wait-on":  "^9.0.4"
                        }
}
